<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Real Wi-Fi scanning. Scan results and the connected BSSID need fine location on every Android version. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Android 12+ shows the location dialog only if COARSE is requested together with FINE. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- WifiManager.startScan() -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Watching the current Wi-Fi connection (ConnectivityManager.NetworkCallback). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+. No neverForLocation: WAVE needs real BSSIDs to spot evil twins. -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <uses-feature android:name="android.hardware.wifi" android:required="true" />
    <!-- Scan QR viewfinder + flashlight. Optional: without a camera, Gallery still reads QR pictures. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".WaveApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WAVE">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.WAVE"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>